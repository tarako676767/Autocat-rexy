# ポート番号（未設定なら5000）
PORT=5000

# ==========================================
# 管理者権限（Admin）の設定
# ==========================================
# あなたの Discord ID（18桁程度の数字）を入力
ADMIN_DISCORD_IDS=1399633592681889864

# ==========================================
# Discord OAuth2 認証設定
# ==========================================
DISCORD_CLIENT_ID=あなたのCLIENT_ID
DISCORD_CLIENT_SECRET=あなたのCLIENT_SECRET
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback
